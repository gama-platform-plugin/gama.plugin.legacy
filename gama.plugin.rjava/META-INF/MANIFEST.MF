Manifest-Version: 1.0
Bundle-ManifestVersion: 2
Bundle-Name: RJava extension
Bundle-SymbolicName: gama.plugin.rjava;singleton:=true
Bundle-Vendor: UMMISCO
Bundle-Version: 2026.6.0.qualifier
