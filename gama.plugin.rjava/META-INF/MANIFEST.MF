 org.rosuda.JRI,
 org.rosuda.REngine,
 org.rosuda.REngine.JRI
Bundle-ClassPath: .,
 lib/JRI.jar,
 lib/JRIEngine.jar,
 lib/REngine.jar
Automatic-Module-Name: gama.plugin.rjava
